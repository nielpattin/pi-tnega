{
   "compilerOptions": {
      "lib": ["ESNext"],
      "types": ["node"],
      "target": "ESNext",
      "module": "Preserve",
      "moduleDetection": "force",
      "jsx": "react-jsx",
      "allowJs": true,
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "verbatimModuleSyntax": true,
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "noFallthroughCasesInSwitch": true,
      "noUncheckedIndexedAccess": false,
      "noImplicitOverride": true,
      "noUnusedLocals": false,
      "noUnusedParameters": false,
      "noPropertyAccessFromIndexSignature": false
   },
   "include": ["packages/**/*.ts", "extensions/**/*.ts"],
   "exclude": [
      "node_modules",
      "git",
      "tmp",
      "dist",
      "extensions/**/examples",
      "packages/**/*.test.ts",
      "packages/**/test/**",
      "extensions/**/*.test.ts",
      "extensions/**/test/**"
   ]
}
