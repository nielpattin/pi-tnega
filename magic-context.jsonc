{
   "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
   "execute_threshold_tokens": {
      "deepseek/deepseek-v4": 300000,
      "opencode-go/deepseek-v4": 300000,
      "cct/deepseek-v4": 300000,
      "xiaomi-token-plan-sgp/mimo-v2.5": 300000
   },
   "historian": {
      "model": "xiaomi-token-plan-sgp/mimo-v2.5",
      "fallback_models": ["xiaomi-token-plan-sgp/mimo-v2.5"],
      "thinking_level": "high"
   },
   "dreamer": {
      "disable": true,
      "inject_docs": false
   },
   "sidekick": {
      "disable": true
   },
   "keep_subagents": true,
   "historian_timeout_ms": 600000,
   "execute_threshold_percentage": 80,
   "memory": {
      "enabled": true
   }
}
