{
   "private": true,
   "type": "module",
   "scripts": {
      "typecheck": "node scripts/typecheck.mjs",
      "lint": "oxlint -c oxlint.config.ts --no-error-on-unmatched-pattern",
      "lint:fix": "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern",
      "fmt": "oxfmt -c oxfmt.config.ts --no-error-on-unmatched-pattern",
      "sync:repos": "node scripts/sync-reference-repos.ts",
      "prepare": "git config core.hooksPath .githooks"
   },
   "dependencies": {
      "@earendil-works/pi-agent-core": "^0.84.0",
      "@earendil-works/pi-ai": "^0.84.0",
      "@earendil-works/pi-coding-agent": "^0.84.0",
      "@earendil-works/pi-tui": "^0.84.0",
      "@sinclair/typebox": "^0.34.52",
      "acorn": "^8.18.0",
      "fzf": "^0.5.2",
      "typebox": "^1.3.8"
   },
   "devDependencies": {
      "@effect/platform-node": "4.0.0-beta.104",
      "@types/node": "^26.1.2",
      "@types/xxhashjs": "^0.2.4",
      "effect": "4.0.0-beta.104",
      "lint-staged": "^17.2.0",
      "oxfmt": "^0.61.0",
      "oxlint": "^1.76.0",
      "oxlint-tsgolint": "^7.0.2001",
      "typescript": "^7.0.2",
      "yoctocolors": "2.2.0"
   },
   "lint-staged": {
      "*.{js,jsx,ts,tsx,mjs,cjs}": [
         "pnpm run lint:fix",
         "pnpm run fmt"
      ]
   },
   "engines": {
      "node": ">=24"
   }
}
