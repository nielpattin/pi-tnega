{
   "private": true,
   "type": "module",
   "scripts": {
      "test": "node --test \"tests/*/**/*.mjs\"",
      "typecheck": "node scripts/typecheck.mjs",
      "package": "pnpm --dir extensions/pi-ide-pro/vscode package",
      "lint": "oxlint -c oxlint.config.ts --no-error-on-unmatched-pattern",
      "lint:fix": "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern",
      "fmt": "oxfmt -c oxfmt.config.ts --no-error-on-unmatched-pattern",
      "sync:repos": "node scripts/sync-reference-repos.ts",
      "prepare": "git config core.hooksPath .githooks"
   },
   "dependencies": {
      "@earendil-works/pi-agent-core": "^0.84.3",
      "@earendil-works/pi-ai": "^0.84.3",
      "@earendil-works/pi-coding-agent": "^0.84.3",
      "@earendil-works/pi-tui": "^0.84.3",
      "@sinclair/typebox": "^0.34.52",
      "acorn": "^8.18.0",
      "fzf": "^0.5.2",
      "typebox": "^1.3.8"
   },
   "devDependencies": {
      "@effect/platform-node": "4.0.0-beta.104",
      "@types/node": "^26.1.2",
      "effect": "4.0.0-beta.104",
      "lint-staged": "^17.2.0",
      "oxfmt": "^0.61.0",
      "oxlint": "^1.76.0",
      "oxlint-tsgolint": "^7.0.2001",
      "typescript": "^7.0.2",
      "yoctocolors": "2.2.0"
   },
   "lint-staged": {
      "*.{js,jsx,ts,tsx,mjs,cjs}": [
         "pnpm run lint:fix",
         "pnpm run fmt"
      ]
   },
   "engines": {
      "node": ">=24.16.0"
   },
   "devEngines": {
      "runtime": {
         "name": "node",
         "version": ">=24.16.0",
         "onFail": "download"
      },
      "packageManager": {
         "name": "pnpm",
         "version": ">=11.22.0 <12",
         "onFail": "download"
      }
   }
}