{
   "private": true,
   "type": "module",
   "scripts": {
      "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
      "test": "vitest run",
      "test:watch": "vitest",
      "coverage": "vitest run --coverage",
      "typecheck": "node scripts/typecheck.mjs",
      "lint": "oxlint -c oxlint.config.ts --no-error-on-unmatched-pattern",
      "lint:fix": "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern",
      "fmt": "oxfmt -c oxfmt.config.ts --no-error-on-unmatched-pattern",
      "fmt:check": "oxfmt -c oxfmt.config.ts --check --no-error-on-unmatched-pattern",
      "prepare": "husky",
      "changeset": "changeset",
      "version-packages": "changeset version && pnpm changelog:sync",
      "release": "changeset publish",
      "changelog:sync": "node scripts/sync-monorepo-changelog.mjs",
      "changeset:check": "node scripts/require-changeset.mjs"
   },
   "dependencies": {
      "@earendil-works/pi-agent-core": "^0.83.0",
      "@earendil-works/pi-ai": "^0.83.0",
      "@earendil-works/pi-coding-agent": "^0.83.0",
      "@earendil-works/pi-tui": "^0.83.0",
      "@sinclair/typebox": "^0.34.52",
      "acorn": "^8.18.0",
      "fzf": "^0.5.2",
      "typebox": "^1.3.8"
   },
   "devDependencies": {
      "@changesets/changelog-git": "^0.2.1",
      "@changesets/cli": "^2.31.1",
      "@types/node": "^26.1.2",
      "@types/xxhashjs": "^0.2.4",
      "@vitest/coverage-v8": "^4.1.10",
      "husky": "^9.1.7",
      "lint-staged": "^17.2.0",
      "oxfmt": "^0.61.0",
      "oxlint": "^1.76.0",
      "oxlint-tsgolint": "^7.0.2001",
      "typescript": "^7.0.2",
      "vitest": "^4.1.10",
      "yoctocolors": "2.2.0"
   },
   "lint-staged": {
      "*.{js,jsx,ts,tsx,mjs,cjs}": [
         "pnpm run lint:fix",
         "pnpm run fmt"
      ]
   },
   "engines": {
      "node": ">=24"
   }
}
