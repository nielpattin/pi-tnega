{
   "type": "module",
   "scripts": {
      "check": "pnpm run fmt:check && pnpm run lint && pnpm run test",
      "test": "vitest run",
      "test:watch": "vitest",
      "lint": "oxlint -c oxlint.config.ts --no-error-on-unmatched-pattern",
      "lint:fix": "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern",
      "fmt": "oxfmt -c oxfmt.config.ts",
      "fmt:check": "oxfmt -c oxfmt.config.ts --check",
      "prepare": "husky"
   },
   "dependencies": {
      "@earendil-works/pi-agent-core": "^0.78.0",
      "@earendil-works/pi-ai": "^0.78.0",
      "@earendil-works/pi-coding-agent": "^0.78.0",
      "@earendil-works/pi-tui": "^0.78.0",
      "@sinclair/typebox": "^0.34.49",
      "fzf": "^0.5.2",
      "typebox": "^1.1.38"
   },
   "devDependencies": {
      "@types/node": "^25.9.1",
      "husky": "^9.1.7",
      "lint-staged": "^17.0.5",
      "oxfmt": "^0.51.0",
      "oxlint": "^1.66.0",
      "oxlint-tsgolint": "^0.23.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.7",
      "yoctocolors": "2.1.2"
   },
   "lint-staged": {
      "*.{js,jsx,ts,tsx,mjs,cjs}": [
         "pnpm run lint:fix",
         "pnpm run fmt"
      ]
   },
   "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
