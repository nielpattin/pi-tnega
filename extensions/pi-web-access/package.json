{
  "name": "@nielpattin/pi-web-access",
  "version": "0.1.0",
  "description": "Fast web search, URL content fetching, Markdown extraction, and PDF reading for Pi.",
  "main": "./index.ts",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "web-search",
    "web-fetch",
    "readability",
    "pdf"
  ],
  "author": "Niel Pattin",
  "license": "MIT",
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.17.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.11",
    "turndown": "^7.2.4",
    "typebox": "^1.3.8"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
