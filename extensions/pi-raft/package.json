{
  "name": "pi-raft",
  "version": "0.1.0",
  "description": "A programmable tool and agent runtime for Pi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "files": [
    "dist/",
    "skillsets/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build.mjs && pnpm run assert:build-artifacts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "node scripts/test-dirty.mjs",
    "test:related": "vitest related --run",
    "check:fast": "pnpm run typecheck && pnpm run test:changed",
    "lint:dead": "knip --no-gitignore",
    "check": "pnpm run typecheck && pnpm run build && pnpm run assert:lazy-graph && pnpm run test && pnpm run lint:dead",
    "assert:lazy-graph": "node scripts/assert-lazy-graph-host-free.mjs",
    "assert:build-artifacts": "node scripts/assert-build-artifacts.mjs",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "mcp",
    "agents"
  ],
  "license": "MIT",
  "author": "nielpattin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nielpattin/pi-raft.git"
  },
  "homepage": "https://github.com/nielpattin/pi-raft#readme",
  "bugs": {
    "url": "https://github.com/nielpattin/pi-raft/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [],
    "image": "https://raw.githubusercontent.com/nielpattin/pi-raft/main/media/banner.svg"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@lezer/common": "^1.5.2",
    "@lezer/python": "^1.1.19",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "mcporter": "^0.12.3",
    "quickjs-emscripten-core": "^0.32.0",
    "shiki": "4.4.3",
    "typebox": "1.3.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@earendil-works/pi-tui": ">=0.80.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "knip": "^6.29.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@pydantic/monty": "0.0.23"
  }
}