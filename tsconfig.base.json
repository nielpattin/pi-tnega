{
   "compilerOptions": {
      "noEmit": true,
      "lib": ["ESNext", "es2023"],
      "types": ["node"],
      "target": "ESNext",
      "module": "Preserve",
      "moduleDetection": "force",
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "verbatimModuleSyntax": true,
      "strict": true,
      "skipLibCheck": true,
      "noFallthroughCasesInSwitch": true
   }
}
