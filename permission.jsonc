{
   "debugLog": false,
   "permissionReviewLog": false,
   "yoloMode": false,
   "permission": {
      "*": "ask",
      "read": {
         "*": "allow",
         "*.env": "ask",
         "*.env.*": "ask",
         "*.env.example": "allow"
      },
      "edit": {
         "*": "allow",
         "*.env": "ask",
         "*.env.*": "ask",
         "*.env.example": "allow",
         "permission.jsonc": "ask",
         "*.md": "ask"
      },
      "write": {
         "*": "allow",
         "*.env": "ask",
         "*.env.*": "ask",
         "*.env.example": "allow",
         "permission.jsonc": "ask",
         "*.md": "ask"
      },
      "grep": "allow",
      "find": "allow",
      "ls": "allow",
      "ffgrep": "allow",
      "fffind": "allow",
      "aft_*": "allow",
      "playwright_*": "allow",
      "ctx_*": "allow",
      "*exa": "allow",
      "describe_image": "allow",
      "read_session": "allow",
      "external_directory": "allow",
      "skill": {
         "*": "allow"
      },
      "ctx*": "allow",
      "todowrite": "allow",
      "todoread": "allow",
      "subagent": "allow",
      "get_subagent_result": "allow",
      "mcp": {
         "mcp_status": "allow"
      },
      "bash": {
         "*": "allow",
         "* git push *": "ask",
         "* git restore *": "ask",
         "* git merge *": "ask",
         "* git rebase *": "ask",
         "* git reset *": "ask",
         "* git rm *": "ask",
         "* git mv *": "ask",
         "* git tag *": "ask",
         "* git clean *": "ask",
         "* git commit *": "ask",
         "git diff *": "allow",
         "* git status*": "allow",
         "* git log *": "allow",
         "* rm *": "ask",
         "* Remove-Item *": "ask",
         "Remove-Item *": "ask",
         "* del *": "ask",
         "* kill *": "ask",
         "* killall *": "ask",
         "* pkill *": "ask",
         "* Stop-Process *": "ask",
         "* Stop-Service *": "ask",
         "* Restart-Service *": "ask",
         "* aspire stop*": "ask",
         "* aspire restart*": "ask",
         "* docker stop *": "ask",
         "* docker rm *": "ask",
         "* docker kill *": "ask",
         "* docker compose down *": "ask",
         "* install *": "ask",
         "* pnpm i*": "ask",
         "* ci *": "ask",
         "chmod +x *": "ask",
         "rg *": "allow",
         "fd *": "allow",
         "ls *": "allow",
         "yay -S *": "ask",
         "sudo *": "ask",
         "sed *": "allow",
         "awk *": "allow",
         "* gh *": "ask",
         "gh run view *": "allow",
         "gh run list *": "allow",
         "find*": "allow",
         "pnpm view *": "allow",
         "pnpm check*": "allow",
         "pnpm test *": "allow",
         "pnpm vitest *": "allow",
         "pnpm lint*": "allow",
         "pnpm fmt*": "allow",
         "pnpm coverage*": "allow",
         "pnpm build*": "allow",
         "pnpm exec oxfmt*": "allow",
         "pnpm --dir * --dry-run": "allow",
         "pnpm --dir * test": "allow",
         "pnpm --dir * check": "allow",
         "grep *": "allow",
         "bash * --path-only": "allow",
         "taskkill *": "ask",
         "pwd": "allow",
         "wc *": "allow",
         "test -f *": "allow",
         "* openspec *": "allow",
         "tail*": "allow",
         "cat *": "allow",
         "head *": "allow",
         "less *": "allow"
      }
